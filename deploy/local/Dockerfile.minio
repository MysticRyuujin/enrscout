# syntax=docker/dockerfile:1.7
FROM golang:1.27@sha256:820153096fda4de6ac1b7194d12e416b7dd8f4e9a33d17e0345b111b945162d8 AS build
ARG MINIO_VERSION=v0.0.0-20260212201848-7aac2a2c5b7c
ARG MC_VERSION=v0.0.0-20251106162529-77f82e18b540
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOBIN=/out go install github.com/minio/minio@${MINIO_VERSION} && \
    install -Dm644 /go/pkg/mod/github.com/minio/minio@${MINIO_VERSION}/LICENSE /out/licenses/minio/LICENSE
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOBIN=/out go install github.com/minio/mc@${MC_VERSION} && \
    install -Dm644 /go/pkg/mod/github.com/minio/mc@${MC_VERSION}/LICENSE /out/licenses/mc/LICENSE
RUN install -d /out/data

FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
COPY --from=build /out/minio /out/mc /usr/local/bin/
COPY --from=build /out/licenses /licenses/
COPY --from=build /out/data /data
# Existing volumes were written by the official image as root.
USER 0:0
ENTRYPOINT ["/usr/local/bin/minio"]
