# syntax=docker/dockerfile:1.7
FROM --platform=$BUILDPLATFORM golang:1.27@sha256:820153096fda4de6ac1b7194d12e416b7dd8f4e9a33d17e0345b111b945162d8 AS build
ARG SOURCE_REVISION=unknown
ARG SOURCE_URL=https://github.com/MysticRyuujin/enrscout
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
RUN --mount=type=bind,source=cmd,target=/src/cmd \
    --mount=type=bind,source=internal,target=/src/internal \
    --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -mod=readonly -trimpath -buildvcs=false \
      -ldflags="-s -w -X github.com/MysticRyuujin/enrscout/internal/buildinfo.Revision=${SOURCE_REVISION} -X github.com/MysticRyuujin/enrscout/internal/buildinfo.SourceURL=${SOURCE_URL}" \
      -o /out/ ./cmd/crawler ./cmd/dnspublisher && \
    mv /out/crawler /out/enrscout-crawler && \
    mv /out/dnspublisher /out/enrscout-dnspublisher && \
    install -d -o 65532 -g 65532 /out/identity

FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
COPY --from=build /out/enrscout-crawler /usr/local/bin/enrscout-crawler
COPY --from=build /out/enrscout-dnspublisher /usr/local/bin/enrscout-dnspublisher
COPY --from=build --chown=65532:65532 /out/identity /identity
COPY LICENSE NOTICE /licenses/enrscout/
LABEL org.opencontainers.image.source="https://github.com/MysticRyuujin/enrscout" \
      org.opencontainers.image.licenses="AGPL-3.0-or-later"
USER nonroot
ENTRYPOINT ["/usr/local/bin/enrscout-crawler"]
